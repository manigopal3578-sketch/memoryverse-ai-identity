# MemoryVerse AI — environment example
# No keys are required to run the demo. These are only needed if you
# replace the deterministic local pipeline with a real backend.

# Backend base URL exposing /upload, /search, /graph
VITE_API_BASE_URL=http://localhost:8000

# Optional: model / vector store configuration for a real backend
OPENAI_API_KEY=
CHROMA_DB_PATH=./.chroma
TESSERACT_CMD=/usr/bin/tesseract
